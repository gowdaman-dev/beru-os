#!/bin/bash

# beru:summary=Reinstall all default Beru packages from the stable channel
# beru:requires-sudo=true

set -e

# Reinstall all default Beru packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
beru-refresh-pacman

# Downgrade any packages to the stable setup
beru-update-pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$BERU_PATH/install/beru-base.packages" | grep -v '^$')
beru-update-pacman -Syu --noconfirm --needed "${packages[@]}"
