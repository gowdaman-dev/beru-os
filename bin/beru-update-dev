#!/bin/bash

# beru:summary=Update the active Beru dev checkout

set -euo pipefail

[[ $BERU_PATH != "/usr/share/beru" ]] || exit 0

if ! git -C "$BERU_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: BERU_PATH is not a git checkout: $BERU_PATH" >&2
  exit 1
fi

upstream=$(git -C "$BERU_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Beru dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Beru dev checkout\e[0m"
git -C "$BERU_PATH" pull --ff-only
