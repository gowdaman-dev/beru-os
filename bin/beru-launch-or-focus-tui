#!/bin/bash

# beru:summary=Launch a TUI or focus an existing terminal window for it
# beru:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.beru.$(basename "$1")"
fi

LAUNCH_COMMAND="beru-launch-tui $@"

exec beru-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
