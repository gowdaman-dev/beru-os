#!/bin/bash

# beru:summary=Install Xbox Cloud Gaming as a web app and launch it.
# beru:group=install
# beru:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
beru-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid beru-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
