#!/bin/bash

# beru:summary=Send the low battery warning notification and run battery-low hooks.
# beru:args=<percentage>
# beru:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: beru-battery-low <percentage>" >&2
  exit 1
fi

level=$1

beru-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
beru-hook battery-low "$level"
