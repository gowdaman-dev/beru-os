#!/bin/bash

# beru:summary=Select and set the system timezone
# beru:group=menu
# beru:name=timezone

set -e

timezone=$(timedatectl list-timezones | beru-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
beru-shell -q beru.clock refresh
beru-notification-send "Timezone is now set to $timezone"
