#!/bin/bash

# beru:summary=Control the Beru menu (toggle / summon / close / refresh)
# beru:args=[toggle|summon|close|refresh|ping] [route]
# beru:examples=beru menu | beru menu toggle system | beru menu summon style.theme | beru menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `beru.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec beru-shell shell toggle beru.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec beru-shell shell summon beru.menu "$(menu_payload "$route")"
    ;;
  close)
    exec beru-shell shell hide beru.menu
    ;;
  refresh | ping)
    exec beru-shell shell call beru.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: beru menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "beru-menu: unknown verb '$verb'. Try 'beru menu --help'." >&2
    exit 2
    ;;
esac
