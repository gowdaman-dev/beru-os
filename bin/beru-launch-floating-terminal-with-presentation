#!/bin/bash

# beru:summary=Launch a floating terminal with the Beru presentation wrapper
# beru:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source beru-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="beru-show-logo; $cmd; code=\$?; if (( code != 130 )); then beru-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.beru.terminal --title=Beru -e bash -c "$presentation_script"
