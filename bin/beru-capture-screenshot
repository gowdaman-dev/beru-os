#!/bin/bash

# beru:summary=Take a screenshot
# beru:group=capture
# beru:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# beru:examples=beru screenshot | beru capture screenshot region
# beru:aliases=beru screenshot

if [[ -n ${BERU_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$BERU_SCREENSHOT_DIR"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
