#!/bin/bash

# beru:summary=Remove Tailscale and its bar plugin.
# beru:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now beru-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
beru-plugin-disable beru.tailscale
beru-webapp-remove "Tailscale" 2>/dev/null || true
beru-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
