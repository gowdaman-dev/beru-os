#!/bin/bash

# beru:summary=Apply Beru system setup in the installed target
# beru:group=apply
# beru:requires-sudo=true
# beru:examples=beru apply system --install-user dhh --first-install
# beru:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: beru apply system --install-user USER [--first-install|--upgrade]
       beru apply system --defer-provisioning --first-install

Runs root-owned Beru system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
beru-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/beru/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${BERU_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: beru-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export BERU_INSTALL_USER="$install_user"
export BERU_FIRST_INSTALL="$first_install"
export BERU_UPGRADE="$upgrade"
export BERU_PATH="${BERU_PATH:-/usr/share/beru}"
export BERU_INSTALL="${BERU_INSTALL:-$BERU_PATH/install}"
export BERU_INSTALL_LOG_FILE="${BERU_INSTALL_LOG_FILE:-/var/log/beru-install.log}"
export PATH="$BERU_PATH/bin:$PATH"

source "$BERU_INSTALL/helpers/logging.sh"
start_install_log

source "$BERU_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  beru-apply-hardware --defer-provisioning
else
  beru-apply-hardware --install-user "$install_user"
fi

source "$BERU_INSTALL/login/all.sh"
source "$BERU_INSTALL/post-install/all.sh"

stop_install_log
