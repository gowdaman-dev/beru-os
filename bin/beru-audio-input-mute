#!/bin/bash

# beru:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  beru-brightness-keyboard-mute on
  beru-osd -i microphone-muted -m "Microphone muted"
else
  beru-brightness-keyboard-mute off
  beru-osd -i microphone -m "Microphone on"
fi
