#!/bin/bash

# beru:summary=Reinstall Beru packages and reset default configs
# beru:requires-sudo=true

set -e

echo -e "This will reinstall all default Beru packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  beru-reinstall-pkgs
  beru-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && beru-system-reboot
fi
