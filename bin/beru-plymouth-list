#!/bin/bash

# beru:summary=List themes that can style the Plymouth boot screen
# beru:examples=beru plymouth list

{
  find ~/.config/beru/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$BERU_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(beru-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
