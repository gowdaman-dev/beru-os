#!/bin/bash

# beru:summary=Remove the GeForce NOW Flatpak app and its data.
# beru:group=remove
# beru:name=gaming geforce-now

set -e

if beru-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
