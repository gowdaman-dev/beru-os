#!/bin/bash

# beru:summary=Record dictation with the configured backend
# beru:args=<start|stop|toggle>
# beru:examples=beru dictation start | beru dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: beru dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/beru/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(beru-default-dictation) || exit 1
adapter="beru-dictation-$backend"
if beru-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
