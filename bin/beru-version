#!/bin/bash

# beru:summary=Print the installed Beru version

omarchy_path=${BERU_PATH:-/usr/share/beru}
omarchy_path=${omarchy_path%/}

if [[ $omarchy_path != "/usr/share/beru" ]]; then
  hash=$(git -C "$omarchy_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs beru-dev instead of beru, so check both.
for package in beru-dev beru; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
