#!/bin/bash

# beru:summary=Show which theme is styling the Plymouth boot screen
# beru:examples=beru plymouth current

# beru-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/beru/logo.png

if cmp -s "$BERU_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

beru-plymouth-list | while read -r name; do
  if cmp -s "$(beru-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
