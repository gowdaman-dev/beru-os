#!/bin/bash

# beru:summary=Log out after closing application windows
# beru:examples=beru logout | beru system logout
# beru:aliases=beru logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

beru-osd -i logout -m "Logging out" -d 5000

# Now close all windows
beru-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
