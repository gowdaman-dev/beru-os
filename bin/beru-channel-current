#!/bin/bash

# beru:summary=Print the active Beru package channel

set -euo pipefail

# Dev is a linked source checkout: BERU_PATH points somewhere other than
# the package-backed install at /usr/share/beru. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $BERU_PATH != "/usr/share/beru" ]]; then
  echo dev
  exit 0
fi

# beru-dev / beru-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. beru / beru-settings come
# from either the stable or rc mirror, distinguished by beru-version-channel
# (which reports the mirror as its first token).
if pacman -Q beru-dev beru-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q beru beru-settings >/dev/null 2>&1; then
  channel=$(beru-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
