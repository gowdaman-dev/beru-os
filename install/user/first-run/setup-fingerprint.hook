#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if beru-hw-fingerprint && [[ ! -f /etc/pam.d/beru-lock-fingerprint ]] &&
  beru-done ensure fingerprint-setup-invitation; then
  beru-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec beru-launch-floating-terminal-with-presentation beru-setup-security-fingerprint
fi
