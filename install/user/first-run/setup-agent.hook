#!/bin/bash

set -e

# Beru ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(beru-default-agent) ]] && beru-done ensure agent-setup-invitation; then
  beru-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Beru." \
    --exec omarchy menu summon setup.default.agent
fi
