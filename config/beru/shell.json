{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "beru.clock",
    "layout": {
      "left": [
        {
          "id": "beru.menu"
        },
        {
          "id": "beru.workspaces"
        }
      ],
      "center": [
        {
          "id": "beru.indicators"
        },
        {
          "id": "beru.elsewhen"
        },
        {
          "id": "beru.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "beru.keyboard-layout"
        },
        {
          "id": "beru.weather"
        },
        {
          "id": "beru.system-update"
        }
      ],
      "right": [
        {
          "id": "beru.tray"
        },
        {
          "id": "beru.agents"
        },
        {
          "id": "beru.bluetooth"
        },
        {
          "id": "beru.network"
        },
        {
          "id": "beru.audio"
        },
        {
          "id": "beru.monitor"
        },
        {
          "id": "beru.power"
        }
      ]
    }
  },
  "plugins": []
}
